{
  "expo": {
    "name": "StudySpace",
    "slug": "studyspace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "studyspace",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.27363.studyspace"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2B4C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tstst.studyspace"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {}
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F2B4C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StudySpace uses your location only to sort study spots by walking time and to confirm you are at a spot when you check in. Precise location is discarded after the check and is never shown to other students."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F2B4C",
          "defaultChannel": "studyspace"
        }
      ],
      "expo-asset",
      "expo-background-task",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "en": "./assets/locales/en.json",
      "es": "./assets/locales/es.json"
    }
  }
}
